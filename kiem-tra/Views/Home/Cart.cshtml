@model List<kiem_tra.Models.CartItem>

@{
    ViewData["Title"] = "Giỏ Hàng";
    var total = Model.Sum(x => x.ThanhTien);
}

<section class="py-5">
    <div class="container">
        <h2 class="mb-4 text-center text-md-left"><i class="fas fa-shopping-cart"></i> Giỏ Hàng Của Bạn</h2>

        @if (!Model.Any())
        {
            <div class="alert alert-info text-center">
                <i class="fas fa-info-circle"></i> Giỏ hàng của bạn đang trống.
                <br />
                <a href="@Url.Action("All", "Product")" class="btn btn-success mt-3">
                    <i class="fas fa-arrow-left"></i> Tiếp Tục Mua Sắm
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="thead-light text-center">
                        <tr>
                            <th>Hình Ảnh</th>
                            <th>Tên Sản Phẩm</th>
                            <th>Đơn Giá</th>
                            <th>Số Lượng</th>
                            <th>Thành Tiền</th>
                            <th>Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center" style="width:120px;">
                                    <img src="~/images/@item.Hinh" class="img-fluid rounded" style="max-height:80px;" alt="@item.TenSp" />
                                </td>
                                <td>@item.TenSp</td>
                                <td class="text-center">@item.DonGia.ToString("N0")₫</td>
                                <td class="text-center" style="width:120px;">
                                    <form method="post" asp-action="UpdateQuantity" asp-controller="Cart" class="d-inline-flex justify-content-center">
                                        <input type="hidden" name="id" value="@item.SanPhamId" />
                                        <input type="number" name="quantity" value="@item.SoLuong" min="1" class="form-control form-control-sm text-center w-50" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary ml-2">
                                            <i class="fas fa-sync-alt"></i>
                                        </button>
                                    </form>
                                </td>
                                <td class="text-center text-primary font-weight-bold">@item.ThanhTien.ToString("N0")₫</td>
                                <td class="text-center">
                                    <form method="post" asp-action="Remove" asp-controller="Cart">
                                        <input type="hidden" name="id" value="@item.SanPhamId" />
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="fas fa-trash-alt"></i> Xóa
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="row mt-4">
                <div class="col-md-6">
                    <a href="@Url.Action("Index", "SanPham")" class="btn btn-outline-primary">
                        <i class="fas fa-arrow-left"></i> Tiếp Tục Mua Sắm
                    </a>
                </div>
                <div class="col-md-6 text-right">
                    <h4 class="font-weight-bold">Tổng Cộng: <span class="text-success">@total.ToString("N0")₫</span></h4>
                    <a href="@Url.Action("Checkout", "Cart")" class="btn btn-success btn-lg mt-3">
                        <i class="fas fa-credit-card"></i> Thanh Toán
                    </a>
                </div>
            </div>
        }
    </div>
</section>
