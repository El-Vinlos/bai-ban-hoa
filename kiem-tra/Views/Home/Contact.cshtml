@{
    ViewData["Title"] = "Liên Hệ";
}

<style>
  .contact-hero {
    background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);
    color: white;
    padding: 80px 0;
    text-align: center;
  }
  .contact-info {
    text-align: center;
    margin-bottom: 30px;
  }
  .contact-info i {
    font-size: 40px;
    color: #667eea;
    margin-bottom: 10px;
  }
  .contact-form {
    background: #fff;
    padding: 40px;
    border-radius: 10px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
  }
  .contact-form .form-control {
    border-radius: 8px;
  }
  .btn-primary {
    border-radius: 8px;
  }
  iframe {
    border-radius: 10px;
  }
</style>

<!-- Hero Section -->
<section class="contact-hero">
  <div class="container">
    <h1 class="display-4 font-weight-bold mb-3">Liên Hệ Với Chúng Tôi</h1>
    <p class="lead">Chúng tôi luôn sẵn sàng hỗ trợ và lắng nghe bạn mọi lúc!</p>
  </div>
</section>

<!-- Contact Info Section -->
<section class="py-5 bg-light">
  <div class="container">
    <div class="row text-center">
      <div class="col-md-4 mb-4">
        <div class="contact-info">
          <i class="fas fa-map-marker-alt"></i>
          <h5 class="mt-3">Địa Chỉ</h5>
          <p>123 Hoa Mai, Quận 1, TP. Hồ Chí Minh</p>
        </div>
      </div>
      <div class="col-md-4 mb-4">
        <div class="contact-info">
          <i class="fas fa-phone-alt"></i>
          <h5 class="mt-3">Điện Thoại</h5>
          <p>+84 123 456 789</p>
        </div>
      </div>
      <div class="col-md-4 mb-4">
        <div class="contact-info">
          <i class="fas fa-envelope"></i>
          <h5 class="mt-3">Email</h5>
          <p>support@hoatuoi.vn</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Contact Form & Map Section -->
<section class="py-5">
  <div class="container mx-auto">
    <div class="row justify-content-center">
      <div class="col-md-8 col-lg-6">
        <div class="contact-form h-100">
          <h3 class="mb-4 text-center text-primary">Gửi Tin Nhắn Cho Chúng Tôi</h3>
          <form method="post" action="#">
            <div class="mb-3">
              <label for="Name" class="form-label">Họ và Tên</label>
              <input type="text" id="Name" name="Name" class="form-control" placeholder="Nhập họ và tên của bạn" required />
            </div>
            <div class="mb-3">
              <label for="Email" class="form-label">Email</label>
              <input type="email" id="Email" name="Email" class="form-control" placeholder="Nhập email của bạn" required />
            </div>
            <div class="mb-3">
              <label for="Message" class="form-label">Nội Dung</label>
              <textarea id="Message" name="Message" rows="5" class="form-control" placeholder="Viết tin nhắn..." required></textarea>
            </div>
            <div class="text-center">
              <button type="submit" class="btn btn-primary btn-lg px-4">Gửi Liên Hệ</button>
            </div>
          </form>
        </div>
      </div>

      <div class="col-md-6 mb-4">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d9859.768365962113!2d0.9347002754331538!3d51.84375330704301!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47d91aa10c65ee4b%3A0xd3f8968e820716c1!2sFingringhoe%2C%20Colchester%20CO5%207BQ%2C%20UK!5e0!3m2!1sen!2s!4v1760432332925!5m2!1sen!2s"
          width="100%"
          height="450"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    </div>
  </div>
</section>
