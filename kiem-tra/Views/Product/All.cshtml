@model List<kiem_tra.Models.SanPham>
@{
    ViewData["Title"] = "Sản phẩm - All";
}

<style>
.card-img-top {
    width: 100%;
    height: 250px;
    object-fit: cover;
    object-position: center;
    border-top-left-radius: 0.5rem;
    border-top-right-radius: 0.5rem;
}
</style>

<section id="products" class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="mb-0">Danh Sách Sản Phẩm</h2>

            <!-- Toggle button (only shows on small screens) -->
            <button class="btn btn-outline-primary d-md-none" type="button"
                    data-toggle="collapse" data-target="#filterMenu"
                    aria-expanded="false" aria-controls="filterMenu">
                <i class="fas fa-filter"></i> Bộ Lọc
            </button>
        </div>

        <div class="row">
            <!-- Filter sidebar -->
            <div class="col-md-3 mb-4">
                <div class="collapse d-md-block" id="filterMenu">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title mb-3">Bộ Lọc</h5>
                            
                            <!-- Category Filter -->
                            <h6 class="mt-3">Loại Hoa</h6>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="rose">
                                <label class="form-check-label" for="rose">Hoa Hồng</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="lily">
                                <label class="form-check-label" for="lily">Hoa Lily</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="sunflower">
                                <label class="form-check-label" for="sunflower">Hoa Hướng Dương</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="mixed">
                                <label class="form-check-label" for="mixed">Hoa Hỗn Hợp</label>
                            </div>

                            <!-- Price Filter -->
                            <h6 class="mt-4">Khoảng Giá</h6>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="price1">
                                <label class="form-check-label" for="price1">Dưới 500.000₫</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="price2">
                                <label class="form-check-label" for="price2">500.000₫ - 1.000.000₫</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="price3">
                                <label class="form-check-label" for="price3">Trên 1.000.000₫</label>
                            </div>

                            <!-- Occasion Filter -->
                            <h6 class="mt-4">Dịp Đặc Biệt</h6>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="birthday">
                                <label class="form-check-label" for="birthday">Sinh Nhật</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="wedding">
                                <label class="form-check-label" for="wedding">Đám Cưới</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="anniversary">
                                <label class="form-check-label" for="anniversary">Kỷ Niệm</label>
                            </div>

                            <button class="btn btn-primary w-100 mt-3">Áp Dụng</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Product Grid -->
            <div class="col-md-9">
                <div class="row">
                    @foreach (var sp in Model)
                    {
                        <div class="col-sm-6 col-md-4 mb-4">
                            <div class="card h-100 text-center shadow-sm">
                                <img src="~/images/@sp.Hinh" class="card-img-top" alt="@sp.TenSp" />
                                <div class="card-body">
                                    <h5 class="card-title mt-3">@sp.TenSp</h5>
                                    <p class="card-text">Số lượng: @sp.SoLuong</p>
                                    <h4 class="text-primary">@sp.DonGia.ToString("N0")₫</h4>
                                    <button class="btn btn-outline-success">Thêm Vào Giỏ</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
